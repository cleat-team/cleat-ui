{
  "name": "@cleat/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Svelte 5 component library for cleat business apps and the cleat.run website",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "svelte": "./src/lib/index.js",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/lib/theme.css",
    "./dist/theme.css": "./dist/theme.css"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package",
    "preview": "vite preview",
    "check": "svelte-check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "files": [
    "dist",
    "src/lib/theme.css",
    "!dist/*.tsbuildinfo"
  ],
  "keywords": [
    "svelte",
    "ui",
    "component-library",
    "cleat"
  ],
  "license": "MIT"
}
