{
  "name": "@cleat/ui",
  "version": "0.2.0",
  "private": false,
  "description": "Shared Svelte 5 component library and theme for cleat-team's apps: clew, cleat-apps and the cleat.run website",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "svelte": "./src/lib/index.js",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/lib/theme.css",
    "./dist/theme.css": "./dist/theme.css",
    "./Button": {
      "svelte": "./src/lib/Button.svelte",
      "types": "./dist/Button.svelte.d.ts",
      "default": "./dist/Button.svelte"
    },
    "./Card": {
      "svelte": "./src/lib/Card.svelte",
      "types": "./dist/Card.svelte.d.ts",
      "default": "./dist/Card.svelte"
    },
    "./Badge": {
      "svelte": "./src/lib/Badge.svelte",
      "types": "./dist/Badge.svelte.d.ts",
      "default": "./dist/Badge.svelte"
    },
    "./Input": {
      "svelte": "./src/lib/Input.svelte",
      "types": "./dist/Input.svelte.d.ts",
      "default": "./dist/Input.svelte"
    },
    "./Modal": {
      "svelte": "./src/lib/Modal.svelte",
      "types": "./dist/Modal.svelte.d.ts",
      "default": "./dist/Modal.svelte"
    },
    "./Table": {
      "svelte": "./src/lib/Table.svelte",
      "types": "./dist/Table.svelte.d.ts",
      "default": "./dist/Table.svelte"
    },
    "./Tabs": {
      "svelte": "./src/lib/Tabs.svelte",
      "types": "./dist/Tabs.svelte.d.ts",
      "default": "./dist/Tabs.svelte"
    },
    "./Form": {
      "svelte": "./src/lib/Form.svelte",
      "types": "./dist/Form.svelte.d.ts",
      "default": "./dist/Form.svelte"
    },
    "./AppShell": {
      "svelte": "./src/lib/AppShell.svelte",
      "types": "./dist/AppShell.svelte.d.ts",
      "default": "./dist/AppShell.svelte"
    },
    "./Layout": {
      "svelte": "./src/lib/Layout.svelte",
      "types": "./dist/Layout.svelte.d.ts",
      "default": "./dist/Layout.svelte"
    },
    "./EmptyState": {
      "svelte": "./src/lib/EmptyState.svelte",
      "types": "./dist/EmptyState.svelte.d.ts",
      "default": "./dist/EmptyState.svelte"
    },
    "./StatusDot": {
      "svelte": "./src/lib/StatusDot.svelte",
      "types": "./dist/StatusDot.svelte.d.ts",
      "default": "./dist/StatusDot.svelte"
    },
    "./Loading": {
      "svelte": "./src/lib/Loading.svelte",
      "types": "./dist/Loading.svelte.d.ts",
      "default": "./dist/Loading.svelte"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package",
    "preview": "vite preview",
    "check": "svelte-check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "files": [
    "dist",
    "src/lib/",
    "!dist/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "svelte",
    "ui",
    "component-library",
    "cleat"
  ],
  "license": "Apache-2.0"
}
